import java.util.*;

public class Main {
    public static void main(String[] args) {
        int nodes = 6;
        int[][] graph = new int[nodes][nodes];

        // Add undirected edges
        addEdge(graph, 0, 1);
        addEdge(graph, 0, 2);
        addEdge(graph, 1, 3);
        addEdge(graph, 1, 4);
        addEdge(graph, 2, 5);

        System.out.print("BFS: ");
        bfs(graph, 0);

        System.out.print("\nDFS: ");
        dfs(graph, 0);
    }

    static void addEdge(int[][] graph, int a, int b) {
        graph[a][b] = 1;
        graph[b][a] = 1; // reverse direction for an undirected edge
    }

    static void bfs(int[][] graph, int start) {
        boolean[] visited = new boolean[graph.length];
        Queue<Integer> queue = new ArrayDeque<>();

        visited[start] = true;
        queue.add(start);

        while (!queue.isEmpty()) {
            int node = queue.remove();
            System.out.print(node + " ");

            // Check every possible node for a connection
            for (int neighbor = 0; neighbor < graph.length; neighbor++) {
                if (graph[node][neighbor] == 1 && !visited[neighbor]) {
                    visited[neighbor] = true;
                    queue.add(neighbor);
                }
            }
        }
    }

    static void dfs(int[][] graph, int start) {
        boolean[] visited = new boolean[graph.length];
        Deque<Integer> stack = new ArrayDeque<>();

        visited[start] = true;
        stack.push(start);

        while (!stack.isEmpty()) {
            int node = stack.pop();
            System.out.print(node + " ");

            // Check every possible node for a connection
            for (int neighbor = 0; neighbor < graph.length; neighbor++) {
                if (graph[node][neighbor] == 1 && !visited[neighbor]) {
                    visited[neighbor] = true;
                    stack.push(neighbor);
                }
            }
        }
    }
}
