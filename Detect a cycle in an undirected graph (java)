//DETECT A CYCLE IN AN UNDIRECTED GRAPH
import java.util.*;

public class Practice{
    public static void main(String[] args){
        List<List<Integer>> graph = new ArrayList<>();
        for(int i = 0; i < 5; i++){
            graph.add(new ArrayList<>());
        }

        addEdge(graph,0,1);
        addEdge(graph,1,2);
        addEdge(graph,2,0);
        addEdge(graph,3,4);

        dfs(graph, 0);

    }
    public static void addEdge(List<List<Integer>> graph, int a, int b){
        graph.get(a).add(b);
        graph.get(b).add(a);
    }
    public static void dfs(List<List<Integer>> graph, int start){
        boolean[] visited = new boolean[graph.size()];
        Deque<Integer> stack = new ArrayDeque<>();
        boolean isCycle = false;

        visited[start] = true;
        stack.push(start);
        int count = 0;
        while(!stack.isEmpty()){
            int node = stack.pop();
            System.out.print(node + " ");
            for(int data : graph.get(node)){
                if(start == data && visited[data] && count > 1){
                    System.out.println("Cycle Detected");
                    System.out.println(count);
                    isCycle = true;
                }
                if(!visited[data]){
                    visited[data] = true;
                    stack.push(data);
                }
            }
            count++;
        }

        if(!isCycle){
            System.out.println("Not cycle");
        }
    }
}
